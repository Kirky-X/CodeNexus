# CodeNexus environment variables template.
#
# Copy this file to `.env` (or export the variables in your shell) and adjust
# as needed. CodeNexus is a CLI tool and does NOT read `.env` files itself;
# this template is for shells, process managers (systemd, supervisord, docker),
# and the `direnv` tool to consume.
#
# Real secrets must never be committed. The `.gitignore` ignores `.env` and
# `.env.*` but explicitly allow-lists `.env.example` via `!.env.example`.

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# `tracing` log level. Supports both a single level and per-module filtering:
#   RUST_LOG=info
#   RUST_LOG=debug
#   RUST_LOG=codenexus=debug,sqlx=warn
# Default if unset: info
RUST_LOG=info

# Per-target level presets, `target=level` pairs separated by commas. They
# out-rank the global level but are out-ranked by `RUST_LOG`, so a preset
# survives a global `RUST_LOG=info` from a process manager. Level names are
# trace|debug|info|warn|error (aliases warning/critical/fatal also accepted);
# invalid entries are reported on stderr and skipped. Unset by default.
#   CODENEXUS_LOG_TARGETS=codenexus::storage::connection=error,lbug=warn
# CODENEXUS_LOG_TARGETS=

# Log sampling, `level=N` or `prefix=N[@level]` pairs separated by commas.
# A key naming a level samples that level N-to-1 (`debug=10`); any other key
# is a target prefix (`sqlx=100`), with the optional `@level` suffix keeping
# records at or above it un-sampled (`sqlx=100@warn`). Decides which records
# survive under rate-limit pressure. Unset by default.
#   CODENEXUS_LOG_SAMPLE=debug=10,sqlx=100@warn
# CODENEXUS_LOG_SAMPLE=

# Per-target-prefix log quotas in tokens/second, `prefix=rate` pairs
# separated by commas (longest prefix wins; targets no rule covers stay
# unthrottled). Useful against chatty dependencies in daemon mode. Unset by
# default.
#   CODENEXUS_LOG_RATE_LIMIT=lbug=50,codenexus::daemon=200
# CODENEXUS_LOG_RATE_LIMIT=

# ----------------------------------------------------------------------------
# Local embedding model (optional)
# ----------------------------------------------------------------------------
# The arctic-embed-xs model directory is not bundled (90 MB); download it to
# `assets/arctic-embed-xs/` or point this at a custom location:
# CODENEXUS_EMBED_MODEL_PATH=/path/to/arctic-embed-xs
#
# Expected SHA-256 of `model.safetensors` (64 hex characters). When set, the
# local engine verifies the weights at load time and rejects a mismatch —
# recommended whenever the bundle did not come from a trusted channel. An
# ill-formed value is reported on stderr and ignored (verification stays
# disabled). Compute with: sha256sum <model-dir>/model.safetensors
# CODENEXUS_EMBED_MODEL_SHA256=<64-hex-digest>

# ----------------------------------------------------------------------------
# Database location (optional)
# ----------------------------------------------------------------------------
# Default LadybugDB database path used when `--db` is not passed to `index`,
# `query`, `status`, the `mcp` serve mode, etc. Precedence: explicit `--db` > CODENEXUS_DB_PATH >
# `.codenexus/config.json` `general.db` (only when no --name/--path signal
# exists) > derived default (`.codenexus/<project>.lbug`, where <project> is
# the --name value or the --path directory name, or the single `.lbug` file
# discovered in `.codenexus/`). Commented out to use the derived default.
# CODENEXUS_DB_PATH=./codenexus.lbug
